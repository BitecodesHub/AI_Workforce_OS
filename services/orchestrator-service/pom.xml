<?xml version="1.0" encoding="UTF-8"?>
<!-- @find: orchestrator-service maven build, pom, dependencies, agents, goals, runs, approvals, chat, schedules, voice, model routing, llm-core, mcp-core, build config
     @what: Maven module definition for the orchestrator service (agents, goals, runs, approvals, chat, schedules, voice).
     @flow: Child of the root pom; depends on platform and llm-core modules -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>os.aiworkforce</groupId>
    <artifactId>ai-workforce-os</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>orchestrator-service</artifactId>
  <name>Orchestrator Service</name>
  <description>
    The working heart of the platform: agent configuration and versioning, goal
    decomposition into a task graph, run execution with persisted checkpoints, agent-to-agent
    handoffs, the approval gate, and language model routing with fail-over.
  </description>

  <dependencies>
    <dependency>
      <groupId>os.aiworkforce</groupId>
      <artifactId>platform-web</artifactId>
    </dependency>
    <dependency>
      <groupId>os.aiworkforce</groupId>
      <artifactId>llm-core</artifactId>
    </dependency>
    <dependency>
      <groupId>os.aiworkforce</groupId>
      <artifactId>mcp-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>orchestrator-service</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- Layered jars keep container rebuilds to the application layer only. -->
          <layers><enabled>true</enabled></layers>
          <excludes>
            <exclude>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
