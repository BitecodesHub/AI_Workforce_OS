<?xml version="1.0" encoding="UTF-8"?>
<!-- @find: org-service build, organisation service, workspaces, invitations, credentials vault, maven module, dependencies, envelope encryption
     @what: Maven build file for the org-service module (workspaces, invitations, encrypted credentials).
     @flow: Inherits the parent pom; depends on platform-web; packaged as org-service.jar for Docker.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>os.aiworkforce</groupId>
    <artifactId>ai-workforce-os</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>org-service</artifactId>
  <name>Organisation Service</name>
  <description>
    Workspaces and how they are governed: organisations, invitations, working hours,
    approval policies, spending caps, runtime settings, and envelope-encrypted integration
    credentials that no read endpoint ever returns in clear.
  </description>

  <dependencies>
    <dependency>
      <groupId>os.aiworkforce</groupId>
      <artifactId>platform-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>org-service</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- Layered jars keep container rebuilds to the application layer only. -->
          <layers><enabled>true</enabled></layers>
          <excludes>
            <exclude>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
