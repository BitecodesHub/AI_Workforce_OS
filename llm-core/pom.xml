<?xml version="1.0" encoding="UTF-8"?>
<!--
  @find: llm-core pom, llm-core maven build, model router dependencies, provider adapters, webflux, jackson, shared LLM library
  @what: Maven build file for llm-core, the shared library holding the model router and every provider adapter.
  @flow: Used by orchestrator-service and knowledge-service.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>os.aiworkforce</groupId>
    <artifactId>ai-workforce-os</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>llm-core</artifactId>
  <name>LLM Core</name>
  <description>
    Provider-independent language model access: one service provider interface, adapters for
    OpenRouter, NVIDIA NIM, Groq, OpenAI, Anthropic, Google Gemini and AWS Bedrock, a
    deterministic sandbox provider, and a router that selects a model, fails over through an
    ordered chain, enforces budgets and records usage for every attempt.
  </description>

  <dependencies>
    <dependency>
      <groupId>os.aiworkforce</groupId>
      <artifactId>platform-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-reactor</artifactId>
    </dependency>

    <!--
      Bedrock is reached over WebClient like every other provider, signed with the SigV4 code in
      os.aiworkforce.llm.bedrock. The SDK's own signer is used only in tests, as an oracle.
    -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>http-auth-aws</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
