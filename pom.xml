<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Aggregator and dependency authority for the whole platform.

    Every module inherits versions from here; no child module pins a third party version
    of its own. The eight services are independent Spring Boot applications that happen to
    build together - each one produces its own executable jar and its own container image.
  -->

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>os.aiworkforce</groupId>
  <artifactId>ai-workforce-os</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>AI Workforce OS</name>
  <description>An enterprise multi-agent platform for business operations</description>

  <modules>
    <module>platform-contracts</module>
    <module>platform-core</module>
    <module>platform-web</module>
    <module>llm-core</module>
    <module>mcp-core</module>
    <module>services/gateway</module>
    <module>services/identity-service</module>
    <module>services/org-service</module>
    <module>services/orchestrator-service</module>
    <module>services/memory-service</module>
    <module>services/knowledge-service</module>
    <module>services/integrations-service</module>
    <module>services/analytics-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <spring-boot.version>3.5.16</spring-boot.version>
    <!--
      Overrides the version Spring Boot manages. Nimbus 9.x cannot export an Ed25519 key as a
      java.security.PublicKey, so the JWT processor cannot build a verifier for it and reports
      "no matching key(s) found" - a message that points at the key set rather than at the real
      cause. Nimbus 10 uses the JDK's own Ed25519 support, which Java 21 has, and needs no
      third-party crypto library at all.
    -->
    <nimbus-jose-jwt.version>10.10</nimbus-jose-jwt.version>
    <spring-cloud.version>2025.0.3</spring-cloud.version>
    <aws-sdk.version>2.39.6</aws-sdk.version>
    <springdoc.version>2.8.13</springdoc.version>
    <resilience4j.version>2.3.0</resilience4j.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <jsonschema.version>1.5.8</jsonschema.version>
    <bouncycastle.version>1.82</bouncycastle.version>
    <tika.version>3.3.2</tika.version>
    <pdfbox.version>3.0.5</pdfbox.version>
    <poi.version>5.4.1</poi.version>
    <wiremock.version>3.13.1</wiremock.version>
    <archunit.version>1.4.1</archunit.version>
    <spotless.version>2.46.1</spotless.version>
    <jacoco.version>0.8.13</jacoco.version>

    <!-- Coverage floor. Raised as the suites fill out; never lowered silently. -->
    <jacoco.line.coverage>0.60</jacoco.line.coverage>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws-sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Platform modules -->
      <dependency>
        <groupId>os.aiworkforce</groupId>
        <artifactId>platform-contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>os.aiworkforce</groupId>
        <artifactId>platform-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>os.aiworkforce</groupId>
        <artifactId>platform-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>os.aiworkforce</groupId>
        <artifactId>llm-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>os.aiworkforce</groupId>
        <artifactId>mcp-core</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!--
        Pinned explicitly rather than through the managed property, which the Spring Boot BOM
        does not expose under a name this build can override.
      -->
      <dependency>
        <groupId>com.nimbusds</groupId>
        <artifactId>nimbus-jose-jwt</artifactId>
        <version>${nimbus-jose-jwt.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-circuitbreaker</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-bulkhead</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-timelimiter</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-retry</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-reactor</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct-processor</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${jsonschema.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tika</groupId>
        <artifactId>tika-core</artifactId>
        <version>${tika.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tika</groupId>
        <artifactId>tika-parsers-standard-package</artifactId>
        <version>${tika.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.pdfbox</groupId>
        <artifactId>pdfbox</artifactId>
        <version>${pdfbox.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.poi</groupId>
        <artifactId>poi-ooxml</artifactId>
        <version>${poi.version}</version>
      </dependency>
      <dependency>
        <groupId>org.wiremock</groupId>
        <artifactId>wiremock-standalone</artifactId>
        <version>${wiremock.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Every module gets the same test baseline. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <palantirJavaFormat/>
              <removeUnusedImports/>
              <importOrder>
                <order>java,javax,jakarta,,os.aiworkforce</order>
              </importOrder>
              <endWithNewline/>
            </java>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <parameters>true</parameters>
          <compilerArgs>
            <arg>-Xlint:all,-serial,-processing</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>org.mapstruct</groupId>
              <artifactId>mapstruct-processor</artifactId>
              <version>${mapstruct.version}</version>
            </path>
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
              <version>${spring-boot.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <!--
        Declared without an execution, so `mvn spotless:check` and `spotless:apply` (make lint and
        make format) resolve it, but no default build runs it. The palantir-java-format release
        this plugin uses does not run on JDK 25, and binding the check to verify made a plain
        `make build` fail on such a machine although the code compiles for release 21 there.
        CI checks the format with -Pformat-check, on JDK 21.
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      The format gate, for CI and `make lint`: `mvn verify -Pformat-check` fails on any file that
      `make format` would change. Kept out of the default build for the reason given at the
      spotless plugin above.
    -->
    <profile>
      <id>format-check</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.diffplug.spotless</groupId>
            <artifactId>spotless-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>format-check</id>
                <phase>verify</phase>
                <goals><goal>check</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Integration tests need Docker for Testcontainers. `mvn verify -Pit` runs them;
      the default build stays fast and hermetic.
    -->
    <profile>
      <id>it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
