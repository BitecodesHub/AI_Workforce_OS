# @find: custom domain, site.env, AIWOS_CUSTOM_DOMAIN, public host name, ai-workforce.bitecodes.com
# @what: Non-secret site settings for the AWS server, read by infra/aws/aiwos.sh from the checkout on every update.
# @flow: aiwos.sh render_site_config: the custom domain becomes the primary address once its DNS A record points at this server's Elastic IP; the sslip.io name keeps working and redirects to it
#
# AIWOS_CUSTOM_DOMAIN: a name whose A record points at the Elastic IP. Leave empty to serve only
# the sslip.io name. Until the name resolves to this server, it is left out entirely (no
# certificate is requested for it), so a pending DNS change never affects the sslip.io site.
AIWOS_CUSTOM_DOMAIN=ai-workforce.bitecodes.com
